{
  "name": "interviewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "An interviewing TUI for Claude Code, painted with UInlay components",
  "type": "module",
  "scripts": {
    "dev": "claude --plugin-dir .",
    "validate": "claude plugin validate .",
    "test": "tsx --test tests/*.spec.ts",
    "test:host": "claude plugin test .",
    "typecheck": "tsc --noEmit",
    "vendor": "node tools/vendor-uinlay.mjs",
    "check": "pnpm run typecheck && pnpm test && pnpm run validate && pnpm run test:host"
  },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
